{
  "name": "groundwork",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/engine.test.mjs tests/lessons.test.mjs",
    "test:ui": "vitest run tests/app.test.jsx tests/lessons-app.test.jsx",
    "check": "npm test && npm run test:ui && npm run build && npm run test:sites",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.2"
  },
  "description": "A small learn-by-doing workbench for rules, executable checks, and human decisions.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scasella/groundwork.git"
  }
}
